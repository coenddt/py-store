        "name": "placeOrder",
        "input": {
          "productId": "p1",
          "warehouse": "w1",
          "qty": 5
        },
        "dryRun": true,
        "expect": {
          "kind": "run",
          "status": "drySucceeded",
          "error": null,
          "stepStates": [
            "ran",
            "skipped",
            "skipped",
            "wouldRun"
          ]
        }
      },
      {
        "op": "query",
        "gql": "Inventory($condition:@c0){_id, stock}",
        "params": {
          "c0": {
            "_id": "inv1"
          }
        },
        "expect": {
          "kind": "rows",
          "rows": [
            {
              "_id": "inv1",
              "stock": 100
            }
          ],
          "normalize": {
            "sortBy": [
              "_id"
            ]
          }
        }
      }
    ],
    "note": "工作流编排设计文档 §7 T5-07。dry-run 只读安全（query 真跑、写不执行）；库存不变。"
  },
  {
    "id": "T5-08",
    "group": "T5",
    "title": "run 自举查询：普通 GQL 查 failed run 命中（可观测性零新接口）",
    "reset": "none",
    "ctx": {
      "userId": "u1",
      "roles": [
        "admin"
      ]
    },
    "sqlPolicy": "parity",
    "steps": [
      {
        "op": "register_workflow",
        "defn": {
          "name": "witnessFail",
          "steps": [
            {
              "op": "fail",
              "message": "库存不足"
            }
          ]
        }
      },
      {
        "op": "run_workflow",
        "name": "witnessFail",
        "input": {},
        "expect": {
          "kind": "run",
          "status": "failed",
          "error": "库存不足",
          "stepIndex": 0,
          "stepStates": [
            "failed"
          ]
        }
      },
      {
        "op": "query",
        "gql": "__workflowRun($condition:@c0,$sort:@s0,$limit:@l1){workflow, status, error, stepIndex}",
        "params": {
          "c0": {
            "workflow": "witnessFail",
            "status": "failed"
          },
          "s0": {
            "now": -1
          },
          "l1": 1
        },
        "expect": {
          "kind": "rows",
          "rows": [
            {
              "workflow": "witnessFail",
              "status": "failed",
              "error": "库存不足",
              "stepIndex": 0
            }
          ],
          "normalize": {
            "ignore": [
              "_id"
            ]
          }
        }
      }
    ],
    "note": "工作流编排设计文档 §7 T5-08。普通 GQL 查 failed run 命中（可观测性零新接口）；用例内自造 witness run + workflow 名过滤 + now 倒序 limit 1——审计留存跨次运行累积时仍幂等定位。"
  },
  {
    "id": "T5-09",
    "group": "T5",
    "title": "跨步骤原子（N1 实测升级）：单源两写步骤、第二步唯一键冲突 → 整体回滚（步骤 2 扣减不残留）",
    "reset": "seed",
    "ctx": {
      "userId": "u1",
      "roles": [
        "admin"
      ]
    },
    "sqlPolicy": "parity",
    "steps": [
      {
        "op": "register_workflow",
        "defn": {
          "name": "orderAndDeduct",
          "run": [
            "admin"
          ],
          "steps": [
            {
              "op": "query",
              "as": "inv",
              "gql": "Inventory($condition:@c0){_id, stock}",
              "params": {
                "c0": {
                  "productId": "{{input.productId}}",
                  "warehouse": "{{input.warehouse}}"
                }
              }
            },
            {
              "op": "mutation",
              "as": "deduct",
              "model": "Inventory",
              "data": {
                "_id": "{{inv._id}}",
                "stock": "{{dec:{{inv.stock}},10}}"
              }
            },
            {
              "op": "mutation",
              "model": "Order",
              "data": {
                "orderNo": "A001",
                "buyerId": "u1",
                "status": "new"
              }
            }
          ]
        }
      },
      {
        "op": "run_workflow",
        "name": "orderAndDeduct",
        "input": {
          "productId": "p1",
          "warehouse": "w1"
        },
        "expect": {
          "kind": "run",
          "status": "failed",
          "stepStates": [
            "ran",
            "ran",
            "failed"
          ]
        }
      },
      {
        "op": "query",
        "gql": "Inventory($condition:@c0){_id, stock}",
        "params": {
          "c0": {
            "_id": "inv1"
          }
        },
        "expect": {
          "kind": "rows",
          "rows": [
            {
              "_id": "inv1",
              "stock": 100
            }
          ],
          "normalize": {
            "sortBy": [
              "_id"
            ]
          }
        }
      }
    ],
    "note": "工作流编排设计文档 §6.2（N1 实测：外层 run_atomic 包住整个 run，内层 mutation 嵌套并入——单源 run 整体原子）。步骤 3 撞 Order.orderNo 唯一索引（A001 seed 既有）→ 失败即停 + 步骤 2 扣减整体回滚。Mongo standalone 降级为既有边界（非原子 + 反馈声明），本场景 replica set 原子成立。"
  }
]