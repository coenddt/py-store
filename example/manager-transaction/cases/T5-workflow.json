    "group": "T5",
    "title": "dry-run：query 真实执行、mutation 记 wouldRun 不执行、终态 drySucceeded",
    "reset": "seed",
    "ctx": {
      "userId": "u1",
      "roles": [
        "admin"
      ]
    },
    "sqlPolicy": "parity",
    "steps": [
      {
